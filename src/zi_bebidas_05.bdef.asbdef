managed implementation in class zbp_i_bebidas_05 unique;
strict ( 2 );

define behavior for ZI_BEBIDAS_05 //alias BEBIDAS
persistent table zbebidas_05
lock master
//authorization master ( instance )
//etag master <field_name>
//{
//  create ( authorization : global );
//  update;
//  delete;
//  field ( readonly ) Codigo;
