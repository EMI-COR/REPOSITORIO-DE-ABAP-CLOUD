authorization master ( global )
{
field ( readonly ) Codigo;
mapping for zbebidas_05
{

  Codigo = codigo;
  Nombre   =     nombre;
  Tipo   =       tipo ;
  Origen    =     origen ;
  Graduacion  =    graduacion ;
  Precio    =    precio ;

}
}