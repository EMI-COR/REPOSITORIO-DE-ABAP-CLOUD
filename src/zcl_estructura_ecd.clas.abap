        out->write( lS_CLIENTE ).

"FORMA 2

     DATA(LS_VAR2) = VALUE  TY_CLIENTE(  NOMBRE = 'EMILIA ' EDAD = 32 ).
      out->write( lS_VAR2 ).


*FORMA 3

DATA: BEGIN OF LS_EMPLEADO2,
       NOMBRE TYPE STRING,
       EDAD TYPE I,
       CORREO TYPE /DMO/EMAIL_ADDRESS,
       END OF LS_EMPLEADO2.

        out->write( lS_EMPLEADO2 ).

 "ESTRUCTURA ANIDADA.

 DATA: BEGIN OF LS_EMPLEADO,

  BEGIN OF INFO,
    ID TYPE I VALUE 1234,
    NOMBRE TYPE STRING VALUE 'EMILIA',
  END OF INFO,


  BEGIN OF DIRECCION,
    CIUDAD TYPE STRING VALUE 'SEVILLA',
    PAIS TYPE STRING VALUE 'ESPAÑA',
