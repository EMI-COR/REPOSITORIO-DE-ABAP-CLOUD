 METHOD if_oo_adt_classrun~main.
 DATA LV_VAR1 TYPE I.


"FORMA 1

 TYPES:BEGIN OF TY_CLIENTE,
       NOMBRE TYPE STRING,
       EDAD TYPE I,
       CORREO TYPE STRING,
