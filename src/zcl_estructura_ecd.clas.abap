       DATA LS_CLIENTE TYPE TY_CLIENTE.

       LS_CLIENTE-NOMBRE = 'JUAN'.
       LS_CLIENTE-edad = 40.
       LS_CLIENTE-correo = 'HOLA@SAP'.
